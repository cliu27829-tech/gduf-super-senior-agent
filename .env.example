# Local Docker defaults. Replace all credentials before exposing a deployment.
ENVIRONMENT=development
POSTGRES_DB=gduf
POSTGRES_USER=gduf
POSTGRES_PASSWORD=change-this-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8000
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=high
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_HISTORY_MESSAGES=20
# VITE_AMAP_JS_KEY 是允许进入浏览器的 JS API Key；下列两项仅供后端读取。
VITE_AMAP_JS_KEY=
AMAP_WEBSERVICE_KEY=
AMAP_SECURITY_CODE=
AMAP_API_BASE_URL=https://restapi.amap.com
AMAP_REQUEST_TIMEOUT_SECONDS=12
